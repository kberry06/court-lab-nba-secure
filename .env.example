PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
TZ=Australia/Sydney
NODE_ENV=development
# Set a long random token in Render secrets; needed for all production writes.
ADMIN_TOKEN=
APP_USERNAME=admin
# Required in production: salted scrypt hash, generated with src/password-hash.js
APP_PASSWORD_HASH=
ODDS_PROVIDER=manual
ODDS_API_KEY=
# Set true only after verifying contractual rights and Sportsbet NBA coverage.
ODDS_FEED_APPROVED=false
